DISCORD_TOKEN=paste_token_here
# Optional. Defaults to donations.db in the current folder.
# DB_PATH=C:\EvilDonations\donations.db
# Optional. Daily backups go here (default: backups folder in the current folder).
# BACKUP_DIR=C:\EvilDonations\backups
# Optional. A second copy of each backup goes here (e.g. a OneDrive folder).
# ONEDRIVE_BACKUP_DIR=C:\Users\YOU\OneDrive\EvilDonations-backups
# Test only. Minutes before 00:00 UTC, comma separated. Default 180,120,60.
# REMINDER_MINUTES=870
